{
  "name": "mork: agent branches only",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/mork/**",
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
